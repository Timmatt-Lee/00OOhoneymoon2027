#!/usr/bin/env sh
set -e
export PATH="/Users/timmatt/.nvm/versions/node/v23.11.0/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

echo "🔍 [pre-commit] Running TypeScript typecheck, unit tests, build & E2E screenshot verification..."
npm run typecheck
npm run test:unit
npm run build
npm run test:e2e

if ! git diff --quiet tests/screenshots/; then
  echo "❌ [pre-commit] 拒絕提交：tests/screenshots/ 截圖與最新程式碼畫面不一致（尚未更新或未 git add）！"
  echo "👉 測試已自動重繪最新截圖，請檢查後執行 git add tests/screenshots/ 再重新 commit。"
  exit 1
fi

echo "✅ [pre-commit] All checks & 12-day screenshots are 100% up-to-date!"
