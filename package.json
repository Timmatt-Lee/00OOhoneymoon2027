    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.10.0",
    "sass": "^1.80.0",
    "subset-font": "^2.9.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
